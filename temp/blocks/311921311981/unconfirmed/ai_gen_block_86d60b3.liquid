{% doc %}
  @prompt
    Create a new Shopify theme section called “Mobile Trust Badge Bar” for the product page and homepage. Build a single card containing up to 6 editable trust badge blocks, with 4 blocks included in the preset. Each badge has an inline SVG icon on the left and editable label text on the right. Use these default preset items and icons: “In stock now” with an availability icon showing a filled circle inside a ring, “Ships nationwide” with a package/box icon, “Per-piece pricing on everything” with a price tag icon, and “No membership, no minimum” with a simple checkmark. All icons must be stroke-based SVGs with a 1.5px stroke and 18x18 dimensions, use aria-hidden="true", and must not be links.
    
    Mobile-first layout up to 749px: full width of the content column with 16px side margins from the screen edge, one badge per row in a single column, 10px icon-to-label gap, 12px vertical gap between rows, 16px card padding on all sides, natural text wrapping with no truncation or ellipsis, and a minimum 24px row height. Align each icon vertically with the first line of its label. At 750px and above: badges 1 and 2 sit side by side in the first row, while badges 3 and 4 each occupy their own full-width row below; use 20px card padding.
    
    Style defaults: card background #F7F9FC, border 1px solid #D8E0EC, 4px border radius, no shadow, gradient, hover effects, or animation. Add an optional left-only full-height accent border, default #1B4F9C, 3px wide. Default icon color #1B7A3D, label color #1A1A1A, body font only, font weight 400, line-height 1.4, font size 14px mobile and 15px desktop. The section schema must include up to 6 blocks of type “badge”, each with a label text field and an icon select with options in-stock, shipping, pricing, and checkmark. Add section settings for background color, border color, accent color, icon color, text color, and a toggle to show/hide the left accent border. Include presets so the section can be added to both product pages and the homepage. Wrap the badges in a ul with one li per badge for accessibility. Do not add a heading. Keep the text readable with at least 4.5:1 contrast against the card background. Do not import a font.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-trust-badge-bar-{{ ai_gen_id }} { display: block; width: {{ block.settings.desktop_width_percent }}%; max-width: 100%; margin: 0 auto; padding: 0 16px; box-sizing: border-box; }
  .ai-trust-badge-bar-{{ ai_gen_id }}__card { width: 100%; box-sizing: border-box; padding: 16px; background: {{ block.settings.background_color }}; border: 1px solid {{ block.settings.border_color }}; border-left: {% if block.settings.show_accent %}3px solid {{ block.settings.accent_color }}{% else %}1px solid {{ block.settings.border_color }}{% endif %}; border-radius: 4px; }
  .ai-trust-badge-bar-{{ ai_gen_id }}__list { display: grid; grid-template-columns: 1fr; gap: 12px; margin: 0; padding: 0; list-style: none; }
  .ai-trust-badge-bar-{{ ai_gen_id }}__item { display: flex; align-items: flex-start; min-height: 24px; gap: 10px; color: {{ block.settings.text_color }}; font-family: inherit; font-size: 14px; font-weight: 400; line-height: 1.4; overflow-wrap: anywhere; }
  .ai-trust-badge-bar-{{ ai_gen_id }}__icon { flex: 0 0 18px; width: 18px; height: 18px; margin-top: 1px; color: {{ block.settings.icon_color }}; }
  .ai-trust-badge-bar-{{ ai_gen_id }}__label { min-width: 0; }
  @media screen and (min-width: 750px) {
    .ai-trust-badge-bar-{{ ai_gen_id }} { padding: 0; }
    .ai-trust-badge-bar-{{ ai_gen_id }}__card { padding: 20px; }
    .ai-trust-badge-bar-{{ ai_gen_id }}__list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .ai-trust-badge-bar-{{ ai_gen_id }}__item:nth-child(n + 3) { grid-column: 1 / -1; }
    .ai-trust-badge-bar-{{ ai_gen_id }}__item { font-size: 15px; }
  }
{% endstyle %}

<div class="ai-trust-badge-bar-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-trust-badge-bar-{{ ai_gen_id }}__card">
    <ul class="ai-trust-badge-bar-{{ ai_gen_id }}__list">
      {% for i in (1..6) %}
        {% assign label_key = 'badge_' | append: i | append: '_label' %}
        {% assign icon_key = 'badge_' | append: i | append: '_icon' %}
        {% assign label = block.settings[label_key] %}
        {% assign icon = block.settings[icon_key] %}
        {% if label != blank %}
          <li class="ai-trust-badge-bar-{{ ai_gen_id }}__item">
            {% case icon %}
              {% when 'in-stock' %}<svg class="ai-trust-badge-bar-{{ ai_gen_id }}__icon" width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><circle cx="9" cy="9" r="6.5" stroke="currentColor" stroke-width="1.5"></circle><circle cx="9" cy="9" r="3" fill="currentColor"></circle></svg>
              {% when 'shipping' %}<svg class="ai-trust-badge-bar-{{ ai_gen_id }}__icon" width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M2.25 4.5h8.25v8.25H2.25V4.5Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path><path d="M10.5 7.125h2.25l2.25 2.25v3.375H10.5V7.125Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path><circle cx="5.25" cy="13.5" r="1.125" stroke="currentColor" stroke-width="1.5"></circle><circle cx="12.75" cy="13.5" r="1.125" stroke="currentColor" stroke-width="1.5"></circle></svg>
              {% when 'pricing' %}<svg class="ai-trust-badge-bar-{{ ai_gen_id }}__icon" width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M2.25 3.75v4.5l7.5 7.5 5.25-5.25-7.5-7.5h-4.5Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path><circle cx="5.625" cy="6.375" r="1" stroke="currentColor" stroke-width="1.5"></circle></svg>
              {% else %}<svg class="ai-trust-badge-bar-{{ ai_gen_id }}__icon" width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="m3.25 9.25 3.5 3.5 8-8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            {% endcase %}
            <span class="ai-trust-badge-bar-{{ ai_gen_id }}__label">{{ label | escape }}</span>
          </li>
        {% endif %}
      {% endfor %}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Mobile trust badge bar",
  "tag": null,
  "class": "trust-badge-bar-block",
  "settings": [
    { "type": "header", "content": "Card style" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#F7F9FC" },
    { "type": "color", "id": "border_color", "label": "Border", "default": "#D8E0EC" },
    { "type": "checkbox", "id": "show_accent", "label": "Show accent border", "default": true },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#1B4F9C" },
    { "type": "color", "id": "icon_color", "label": "Icons", "default": "#1B7A3D" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#1A1A1A" },
    { "type": "header", "content": "Badge 1" },
    { "type": "text", "id": "badge_1_label", "label": "Label", "default": "In stock now" },
    { "type": "select", "id": "badge_1_icon", "label": "Icon", "options": [{ "value": "in-stock", "label": "In stock" }, { "value": "shipping", "label": "Shipping" }, { "value": "pricing", "label": "Pricing" }, { "value": "checkmark", "label": "Checkmark" }], "default": "in-stock" },
    { "type": "header", "content": "Badge 2" },
    { "type": "text", "id": "badge_2_label", "label": "Label", "default": "Ships nationwide" },
    { "type": "select", "id": "badge_2_icon", "label": "Icon", "options": [{ "value": "in-stock", "label": "In stock" }, { "value": "shipping", "label": "Shipping" }, { "value": "pricing", "label": "Pricing" }, { "value": "checkmark", "label": "Checkmark" }], "default": "shipping" },
    { "type": "header", "content": "Badge 3" },
    { "type": "text", "id": "badge_3_label", "label": "Label", "default": "Per-piece pricing on everything" },
    { "type": "select", "id": "badge_3_icon", "label": "Icon", "options": [{ "value": "in-stock", "label": "In stock" }, { "value": "shipping", "label": "Shipping" }, { "value": "pricing", "label": "Pricing" }, { "value": "checkmark", "label": "Checkmark" }], "default": "pricing" },
    { "type": "header", "content": "Badge 4" },
    { "type": "text", "id": "badge_4_label", "label": "Label", "default": "No membership, no minimum" },
    { "type": "select", "id": "badge_4_icon", "label": "Icon", "options": [{ "value": "in-stock", "label": "In stock" }, { "value": "shipping", "label": "Shipping" }, { "value": "pricing", "label": "Pricing" }, { "value": "checkmark", "label": "Checkmark" }], "default": "checkmark" },
    { "type": "header", "content": "Badge 5" },
    { "type": "text", "id": "badge_5_label", "label": "Label" },
    { "type": "select", "id": "badge_5_icon", "label": "Icon", "options": [{ "value": "in-stock", "label": "In stock" }, { "value": "shipping", "label": "Shipping" }, { "value": "pricing", "label": "Pricing" }, { "value": "checkmark", "label": "Checkmark" }], "default": "checkmark" },
    { "type": "header", "content": "Badge 6" },
    { "type": "text", "id": "badge_6_label", "label": "Label" },
    { "type": "select", "id": "badge_6_icon", "label": "Icon", "options": [{ "value": "in-stock", "label": "In stock" }, { "value": "shipping", "label": "Shipping" }, { "value": "pricing", "label": "Pricing" }, { "value": "checkmark", "label": "Checkmark" }], "default": "checkmark" }
  ],
  "presets": [{ "name": "Mobile trust badge bar" }]
}
{% endschema %}