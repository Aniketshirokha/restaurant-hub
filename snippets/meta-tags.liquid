{% doc %}
  Renders all meta tags for the page including Open Graph, Twitter Cards, and SEO tags.

  @param {object} [product] - The product object, available on product pages for price meta tags.
{% enddoc %}

<meta charset="utf-8">
<meta
  http-equiv="X-UA-Compatible"
  content="IE=edge"
>
<meta
  name="viewport"
  content="width=device-width,initial-scale=1"
>
<meta
  name="theme-color"
  content=""
>

{%- liquid
  assign brand = settings.rsh_brand_name | default: shop.name
  assign seo_title = page_title
  assign seo_description = page_description
  if request.page_type == 'index'
    if settings.rsh_home_title != blank
      assign seo_title = settings.rsh_home_title
    endif
    if seo_description == blank and settings.rsh_home_description != blank
      assign seo_description = settings.rsh_home_description
    endif
  endif
  assign og_title = seo_title | default: brand
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = seo_description | default: shop.description | default: brand

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif
%}

<meta
  property="og:site_name"
  content="{{ brand | escape }}"
>
<meta
  property="og:url"
  content="{{ og_url }}"
>
<meta
  property="og:title"
  content="{{ og_title | escape }}"
>
<meta
  property="og:type"
  content="{{ og_type }}"
>
<meta
  property="og:description"
  content="{{ og_description | escape }}"
>

{%- comment -%}
  Products and collections carry their own `page_image` and keep it. Everything
  else falls back to `og-share.webp`, so a link to the home page, a policy page
  or a blog post never shares as a blank card.
{%- endcomment -%}
{%- liquid
  unless page_image
    capture share_image
      echo 'og-share.webp' | file_img_url: '1200x675', crop: 'center'
    endcapture
    assign share_image = share_image | strip
    if share_image != blank
      assign protocol = share_image | slice: 0, 2
      if protocol == '//'
        assign share_image = share_image | prepend: 'https:'
      endif
    endif
  endunless
-%}

{%- if page_image -%}
  <meta
    property="og:image"
    content="http:{{ page_image | image_url }}"
  >
  <meta
    property="og:image:secure_url"
    content="https:{{ page_image | image_url }}"
  >
  <meta
    property="og:image:width"
    content="{{ page_image.width }}"
  >
  <meta
    property="og:image:height"
    content="{{ page_image.height }}"
  >
{%- elsif share_image != blank -%}
  <meta
    property="og:image"
    content="{{ share_image }}"
  >
  <meta
    property="og:image:secure_url"
    content="{{ share_image }}"
  >
  <meta
    property="og:image:width"
    content="1200"
  >
  <meta
    property="og:image:height"
    content="675"
  >
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <meta
    property="og:price:amount"
    content="{{ product.price | money_without_currency | strip_html }}"
  >
  <meta
    property="og:price:currency"
    content="{{ cart.currency.iso_code }}"
  >
{%- endif -%}

{%- if settings.social_twitter_link != blank -%}
  <meta
    name="twitter:site"
    content="{{ settings.social_twitter_link | split: 'twitter.com/' | last | prepend: '@' }}"
  >
{%- endif -%}
<meta
  name="twitter:card"
  content="summary_large_image"
>
<meta
  name="twitter:title"
  content="{{ og_title | escape }}"
>
<meta
  name="twitter:description"
  content="{{ og_description | escape }}"
>
{%- if page_image -%}
  <meta
    name="twitter:image"
    content="https:{{ page_image | image_url }}"
  >
{%- elsif share_image != blank -%}
  <meta
    name="twitter:image"
    content="{{ share_image }}"
  >
{%- endif -%}

<title>
  {{ seo_title }}
  {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
  {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
  {%- unless seo_title contains brand or seo_title contains shop.name %} &ndash; {{ brand }}{% endunless -%}
</title>

<link
  rel="canonical"
  href="{{ canonical_url }}"
>

{% if seo_description != blank %}
  <meta
    name="description"
    content="{{ seo_description | escape }}"
  >
{% endif %}
