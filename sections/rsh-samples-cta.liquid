{%- doc -%}
  The sample request call to action.

  Two placements, one file. On the home page it is the closing band under the
  main CTA; on /pages/samples it sits inline beside the request form rather than
  as a header band, because a buyer who has reached that page is there to fill
  the form in and a band would push it down the screen.

  `samples-three-case.webp` is square and renders at 600px, so it is capped here
  rather than allowed to stretch across a full-width section.
{%- enddoc -%}

{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>

<div
  class="
    section
    section--{{ section.settings.section_width }}
    {% if section.settings.background_color != blank %}color-custom-{{ section.id }}{% endif %}
    spacing-style
  "
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <div class="rsh-samples rsh-samples--media-{{ section.settings.media_position }}">
    {%- if section.settings.show_image -%}
      <figure class="rsh-samples__media">
        {%- render 'rsh-image',
          key: 'samples-three-case',
          sizes: '(min-width: 750px) 300px, 60vw'
        -%}
      </figure>
    {%- endif -%}

    <div class="rsh-samples__body">
      {%- if section.settings.eyebrow != blank -%}
        <p class="rsh-eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="rsh-heading h2">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.body != blank -%}
        <div class="rsh-lede rte">{{ section.settings.body }}</div>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <div class="rsh-actions">
          <a href="{{ section.settings.button_link }}" class="button">
            {{ section.settings.button_label }}
          </a>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Samples CTA",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Show samples-three-case.webp",
      "default": true
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Not sure it is the right container?"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>Ask for a sample case. We will send the container, the cup and the glove you are comparing, so you can put your own food in it before you commit to a pallet.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Request a free sample case"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "media_position",
      "label": "Picture position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Full" }
      ],
      "default": "page-width"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "placeholder": "Default"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Samples CTA"
    }
  ]
}
{% endschema %}
