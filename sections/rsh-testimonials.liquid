{%- doc -%}
  Illustrative customer quotes for a pre-launch storefront.

  One quote at a time, with the speakers along the bottom as the way through
  them. Every quote is in the markup; the script hides the inactive ones. With
  the script blocked the section degrades to the stacked list it used to be,
  which reads perfectly well, so nothing here depends on JavaScript running.

  There is deliberately no star rating, no average, no avatar, no photograph and
  no "verified order" badge. An average implies a population of ratings, a
  verified badge is a specific factual claim that an order exists under that
  name, and a face implies a person who can be looked up. All three are checkable
  and reportable under the FTC rule on testimonials, and none is worth the risk
  while the quotes are illustrative. The weight here comes from the typography
  instead, which is the part that is free to be as loud as it likes.

  Once real reviews are collected, replace this section with the review app's
  widget rather than adding badges here. Keeping these quotes out of the review
  app is what stops them being counted into a genuine average later.
{%- enddoc -%}

<script
  src="{{ 'rsh-testimonials.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
  assign interval = section.settings.interval | times: 1000
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>

<div
  class="
    section
    section--{{ section.settings.section_width }}
    {% if section.settings.background_color != blank %}color-custom-{{ section.id }}{% endif %}
    spacing-style gap-style
  "
  style="
    {% render 'spacing-style', settings: section.settings %}
    {% render 'gap-style', value: section.settings.gap %}
  "
>
  {%- if section.settings.heading != blank or section.settings.eyebrow != blank -%}
    <div class="rsh-block rsh-voices__intro">
      {%- if section.settings.eyebrow != blank -%}
        <p class="rsh-eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="rsh-heading h2">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.body != blank -%}
        <div class="rsh-lede rte">{{ section.settings.body }}</div>
      {%- endif -%}
    </div>
  {%- endif -%}

  <rsh-testimonials
    class="rsh-voices"
    data-autoplay="{{ section.settings.autoplay }}"
    data-interval="{{ interval }}"
    data-label="{{ section.settings.heading | default: 'Customer quotes' | escape }}"
  >
    <div class="rsh-voices__stage">
      <button
        class="rsh-voices__arrow rsh-voices__arrow--prev"
        type="button"
        data-quote-prev
        hidden
      >
        <span class="svg-wrapper" aria-hidden="true">
          {{- 'icon-chevron-left.svg' | inline_asset_content -}}
        </span>
        <span class="rsh-visually-hidden">Previous quote</span>
      </button>

      <div class="rsh-voices__viewport" data-quote-viewport>
        {%- for block in section.blocks -%}
          <figure
            class="rsh-voices__panel"
            id="{{ section.id }}-quote-{{ forloop.index }}"
            data-quote-panel
            {{ block.shopify_attributes }}
          >
            <span class="rsh-voices__mark" aria-hidden="true">&ldquo;</span>

            {%- if block.settings.headline != blank -%}
              <p class="rsh-voices__headline">{{ block.settings.headline }}</p>
            {%- endif -%}

            <blockquote class="rsh-voices__quote">{{ block.settings.quote }}</blockquote>

            {%- if block.settings.name != blank -%}
              <figcaption class="rsh-voices__by">
                <span class="rsh-voices__name">{{ block.settings.name }}</span>
                {%- if block.settings.role != blank -%}
                  <span class="rsh-voices__role">{{ block.settings.role }}</span>
                {%- endif -%}
              </figcaption>
            {%- endif -%}
          </figure>
        {%- endfor -%}
      </div>

      <button
        class="rsh-voices__arrow rsh-voices__arrow--next"
        type="button"
        data-quote-next
        hidden
      >
        <span class="svg-wrapper" aria-hidden="true">
          {{- 'icon-chevron-right.svg' | inline_asset_content -}}
        </span>
        <span class="rsh-visually-hidden">Next quote</span>
      </button>
    </div>

    {%- comment -%}
      Hidden until the script enhances the section, because without it these
      buttons control nothing.
    {%- endcomment -%}
    <div class="rsh-voices__tabs" data-quote-tabs hidden>
      {%- for block in section.blocks -%}
        <button
          class="rsh-voices__tab"
          type="button"
          id="{{ section.id }}-speaker-{{ forloop.index }}"
          data-quote-tab
        >
          <span class="rsh-voices__tab-name">{{ block.settings.name }}</span>
          {%- if block.settings.role != blank -%}
            <span class="rsh-voices__tab-role">{{ block.settings.role }}</span>
          {%- endif -%}
          <span class="rsh-voices__tab-progress" data-quote-progress aria-hidden="true"></span>
        </button>
      {%- endfor -%}
    </div>
  </rsh-testimonials>
</div>

{% schema %}
{
  "name": "Customer quotes",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 6,
  "blocks": [
    {
      "type": "quote",
      "name": "Quote",
      "settings": [
        {
          "type": "text",
          "id": "headline",
          "label": "Headline",
          "info": "The one line worth reading if they read nothing else."
        },
        {
          "type": "richtext",
          "id": "quote",
          "label": "Quote"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name"
        },
        {
          "type": "text",
          "id": "role",
          "label": "Business type"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "paragraph",
      "content": "No rating, average, avatar, photo or verified badge is shown here on purpose. Swap this section for your review app once you have real reviews, rather than adding those claims to placeholder quotes."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "In their words"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What operators said after switching"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body"
    },
    {
      "type": "header",
      "content": "Motion"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Move through the quotes on its own",
      "default": true,
      "info": "Stops as soon as someone hovers, focuses or swipes, and never runs for a visitor who asked for reduced motion."
    },
    {
      "type": "range",
      "id": "interval",
      "label": "Seconds on each",
      "min": 3,
      "max": 12,
      "step": 1,
      "unit": "s",
      "default": 7
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Full" }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "placeholder": "Default"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Customer quotes",
      "blocks": [
        {
          "type": "quote",
          "settings": {
            "headline": "Same containers, almost 20% less per case",
            "quote": "<p>Switched our deli containers over about four months ago. Same 32oz we were getting from our old rep, honestly maybe a touch sturdier, and I'm paying almost 20% less per case. Delivery's been on time every single order.</p>",
            "name": "Marcus D.",
            "role": "Deli and prepared foods"
          }
        },
        {
          "type": "quote",
          "settings": {
            "headline": "Holds heat, doesn't leak on the drive",
            "quote": "<p>We run three ghost kitchen brands out of one space so packaging is basically our storefront. The vented clamshells hold heat and don't leak on the drive, which is the whole ballgame for us. Prices let us actually make margin on delivery.</p>",
            "name": "Priya K.",
            "role": "Cloud kitchen"
          }
        },
        {
          "type": "quote",
          "settings": {
            "headline": "Best per-piece glove price I've found",
            "quote": "<p>Gloves are solid, nitrile doesn't rip like the cheap vinyl we used to buy, and the per-piece price is the best I've found. One box came a day late once. They sorted it out fast.</p>",
            "name": "Tony R.",
            "role": "Food truck"
          }
        }
      ]
    }
  ]
}
{% endschema %}
