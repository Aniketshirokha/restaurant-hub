{%- doc -%}
  The category grid: the five parent collections, and compostable as a sixth.

  The tiles reuse the same `col-*.webp` files as the collection page banners, so
  there is one picture per category and it is recognisable in both places. Those
  files are 21:9 built around an empty left third for an overlaid title. A tile
  does not overlay its title, so the tile crops to 16:9 and puts the title
  underneath. Cropping them to a tile shape from the centre keeps most of the
  composition; going tighter than 16:9 starts throwing the cases away.

  The tile takes its title and link from the collection it points at, so renaming
  a collection cannot leave a tile stale.
{%- enddoc -%}

{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>

<div
  class="
    section
    section--{{ section.settings.section_width }}
    {% if section.settings.background_color != blank %}color-custom-{{ section.id }}{% endif %}
    spacing-style gap-style
  "
  style="
    {% render 'spacing-style', settings: section.settings %}
    {% render 'gap-style', value: section.settings.gap %}
  "
>
  {%- if section.settings.heading != blank or section.settings.body != blank -%}
    <div class="rsh-block">
      {%- if section.settings.eyebrow != blank -%}
        <p class="rsh-eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="rsh-heading h2">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.body != blank -%}
        <div class="rsh-lede rte">{{ section.settings.body }}</div>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="rsh-cards">
    {%- for block in section.blocks -%}
      {%- liquid
        assign linked_collection = block.settings.collection

        assign card_title = block.settings.title
        if card_title == blank and linked_collection != blank
          assign card_title = linked_collection.title
        endif

        assign card_url = block.settings.link
        if card_url == blank and linked_collection != blank
          assign card_url = linked_collection.url
        endif

        assign tile_key = block.settings.banner
        if tile_key == 'none'
          assign tile_key = ''
        endif

        # Anything picked here wins. Otherwise the named file, and until that is
        # uploaded, whatever picture the collection already has.
        assign tile_fallback = block.settings.image
        if tile_fallback != blank
          assign tile_key = ''
        endif
        if tile_fallback == blank and linked_collection != blank
          assign tile_fallback = linked_collection.image
        endif
        if tile_fallback == blank and linked_collection != blank
          assign tile_fallback = linked_collection.products.first.featured_image
        endif

        assign tile_has_media = false
        if tile_key != blank or tile_fallback != blank
          assign tile_has_media = true
        endif
      -%}
      <article class="rsh-card rsh-card--wide" {{ block.shopify_attributes }}>
        {%- if tile_has_media -%}
          <div class="rsh-card__media rsh-card__media--wide">
            {%- render 'rsh-image',
              key: tile_key,
              fallback_image: tile_fallback,
              ratio: '16:9',
              sizes: '(min-width: 990px) 32vw, (min-width: 750px) 46vw, 100vw'
            -%}
          </div>
        {%- endif -%}

        <div class="rsh-card__body">
          <h3 class="rsh-card__title">
            {%- if card_url != blank -%}
              <a href="{{ card_url }}">{{ card_title }}</a>
            {%- else -%}
              {{ card_title }}
            {%- endif -%}
          </h3>
          {%- if block.settings.text != blank -%}
            <p class="rsh-card__text">{{ block.settings.text }}</p>
          {%- endif -%}
        </div>
      </article>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Category grid",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 8,
  "blocks": [
    {
      "type": "tile",
      "name": "Category",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "select",
          "id": "banner",
          "label": "Picture",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "col-food-packaging", "label": "Food packaging" },
            { "value": "col-food-service", "label": "Food service" },
            { "value": "col-disposable-gloves", "label": "Disposable gloves" },
            { "value": "col-paper-products", "label": "Paper products" },
            { "value": "col-janitorial-cleaning", "label": "Janitorial and cleaning" },
            { "value": "col-compostable", "label": "Compostable" }
          ],
          "default": "none"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image override",
          "info": "Only to override the picture above. Left empty, the tile uses the named file, then the collection's own image."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "info": "Defaults to the collection title."
        },
        {
          "type": "text",
          "id": "text",
          "label": "Subtitle"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Defaults to the collection."
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Full" }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "placeholder": "Default"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Category grid",
      "blocks": [
        { "type": "tile", "settings": { "title": "Food packaging", "banner": "col-food-packaging" } },
        { "type": "tile", "settings": { "title": "Food service", "banner": "col-food-service" } },
        { "type": "tile", "settings": { "title": "Disposable gloves", "banner": "col-disposable-gloves" } },
        { "type": "tile", "settings": { "title": "Paper products", "banner": "col-paper-products" } },
        { "type": "tile", "settings": { "title": "Janitorial and cleaning", "banner": "col-janitorial-cleaning" } },
        { "type": "tile", "settings": { "title": "Compostable", "banner": "col-compostable" } }
      ]
    }
  ]
}
{% endschema %}
