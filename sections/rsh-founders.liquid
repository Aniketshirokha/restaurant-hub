{%- doc -%}
  The founders' story: the long paragraphs, three figures under them and a
  photograph beside.

  The figures are rendered as numbers, not counted up to by a script. A
  counter that starts at zero shows zero to every crawler, every reader with a
  blocked script and every screenshot, which is the opposite of proof.

  The product figure is the store's own count, so it is never a number that
  has to be remembered to update.
{%- enddoc -%}

{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<div class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"></div>
<div
  class="section section--{{ section.settings.section_width }}{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %} spacing-style"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <div class="rsh-founders">
    <div class="rsh-founders__story">
      {%- if section.settings.eyebrow != blank -%}
        <p class="rsh-eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="rsh-heading h2">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.body != blank -%}
        <div class="rsh-founders__body rte">{{ section.settings.body }}</div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <ul class="rsh-founders__figures" role="list">
          {%- for block in section.blocks -%}
            {%- liquid
              assign value = block.settings.value
              if block.settings.source == 'product_count'
                assign value = collections.all.all_products_count
                if value == 0
                  assign value = ''
                endif
              endif
            -%}
            {%- if value != blank -%}
              <li class="rsh-founders__figure" {{ block.shopify_attributes }}>
                <span class="rsh-founders__value">{{ value }}</span>
                <span class="rsh-founders__label">{{ block.settings.label }}</span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    {%- liquid
      # The media is decided here so the figure is only written when there is
      # something to put in it. A figure holding a snippet that drew nothing
      # still holds whitespace, which is enough to keep an empty column open.
      capture media
        if section.settings.media == 'logo' and settings.logo != blank
          echo '<div class="rsh-founders__logo">'
          echo settings.logo | image_url: width: 800 | image_tag: widths: '320, 480, 640, 800', sizes: '(min-width: 990px) 320px, 60vw', loading: 'lazy', class: 'rsh-founders__logo-img', alt: shop.name
          echo '</div>'
        elsif section.settings.image != blank
          echo section.settings.image | image_url: width: 1600 | image_tag: widths: '500, 800, 1000, 1600', sizes: '(min-width: 990px) 42vw, 100vw', loading: 'lazy', class: 'rsh-founders__img'
        elsif section.settings.image_key != blank
          render 'rsh-image', key: section.settings.image_key, sizes: '(min-width: 990px) 42vw, 100vw'
        endif
      endcapture
      assign media = media | strip
    -%}
    {%- if media != blank -%}
      <figure class="rsh-founders__media{% if section.settings.media == 'logo' %} rsh-founders__media--logo{% endif %}">{{ media }}</figure>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Founders",
  "tag": "section",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The founders" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "We've spent 17 years learning what this stuff should actually cost" },
    { "type": "richtext", "id": "body", "label": "Story" },
    { "type": "header", "content": "Beside the story" },
    {
      "type": "select",
      "id": "media",
      "label": "Show",
      "options": [
        { "value": "photo", "label": "A photograph" },
        { "value": "logo", "label": "The store logo" }
      ],
      "default": "photo",
      "info": "The logo is the one set under Theme settings, Logo."
    },
    { "type": "image_picker", "id": "image", "label": "Photograph" },
    { "type": "text", "id": "image_key", "label": "Or a library file", "default": "sourcing-factory-floor", "info": "Used when no image is chosen above." },
    { "type": "header", "content": "Layout" },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [ { "value": "page-width", "label": "Page" }, { "value": "full-width", "label": "Full" } ],
      "default": "page-width"
    },
    { "type": "color", "id": "background_color", "label": "Background", "placeholder": "Default" },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding-block-start", "label": "Top", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding-block-end", "label": "Bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 72 }
  ],
  "blocks": [
    {
      "type": "figure",
      "name": "Figure",
      "settings": [
        {
          "type": "select",
          "id": "source",
          "label": "Value",
          "options": [
            { "value": "custom", "label": "Type it below" },
            { "value": "product_count", "label": "Count the products in the store" }
          ],
          "default": "custom"
        },
        { "type": "text", "id": "value", "label": "Figure" },
        { "type": "text", "id": "label", "label": "Label" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Founders",
      "blocks": [
        { "type": "figure", "settings": { "value": "17", "label": "Years of combined sourcing" } },
        { "type": "figure", "settings": { "value": "2", "label": "Founders on the factory floor" } },
        { "type": "figure", "settings": { "source": "product_count", "label": "Restaurant-grade products" } }
      ]
    }
  ]
}
{% endschema %}
