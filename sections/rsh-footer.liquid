{%- doc -%}
  The footer, on ink. A newsletter row across the top, then the brand beside
  three columns of links, then the small print: payment marks, the policies
  the store has actually written, the copyright and a way back up.

  The link columns read the store's own menus, so a link added under
  Navigation appears here without touching the theme, and a column can show
  one branch of a menu (the children of "Shop", say) rather than the whole
  thing. Anything that would be empty is not drawn: a policy with no text,
  a social network with no address, a column with no links.
{%- enddoc -%}

{%- liquid
  assign email = section.settings.email | default: shop.email
  assign year = 'now' | date: '%Y'
-%}

<div class="section-background rsh-footer__bg"></div>
<footer
  class="section section--page-width spacing-style rsh-footer"
  style="{% render 'spacing-style', settings: section.settings %}"
  aria-label="Footer"
>
  {%- if section.settings.show_signup -%}
    <div class="rsh-footer__signup">
      <div class="rsh-footer__signup-copy">
        {%- if section.settings.signup_heading != blank -%}
          <h2 class="rsh-footer__signup-heading">{{ section.settings.signup_heading }}</h2>
        {%- endif -%}
        {%- if section.settings.signup_text != blank -%}
          <p class="rsh-footer__signup-text">{{ section.settings.signup_text }}</p>
        {%- endif -%}
      </div>
      {%- form 'customer', class: 'rsh-footer__form', id: 'rsh-footer-signup' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        {%- if form.posted_successfully? -%}
          <p class="rsh-footer__form-status" role="status">{{ section.settings.signup_success | default: "You're on the list." }}</p>
        {%- else -%}
          <label for="rsh-footer-email" class="rsh-visually-hidden">Email</label>
          <div class="rsh-footer__field">
            <input
              id="rsh-footer-email"
              type="email"
              name="contact[email]"
              autocomplete="email"
              autocorrect="off"
              autocapitalize="off"
              placeholder="{{ section.settings.signup_placeholder | default: 'Work email' }}"
              required
              {% if form.errors %}aria-invalid="true" aria-describedby="rsh-footer-email-error"{% endif %}
            >
            <button type="submit" class="rsh-footer__submit">
              {{ section.settings.signup_button | default: 'Sign up' }}
              <span aria-hidden="true">&rarr;</span>
            </button>
          </div>
          {%- if form.errors -%}
            <p id="rsh-footer-email-error" class="rsh-footer__form-status rsh-footer__form-status--error" role="alert">
              {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
            </p>
          {%- endif -%}
        {%- endif -%}
      {%- endform -%}
    </div>
  {%- endif -%}

  <div class="rsh-footer__main">
    <div class="rsh-footer__brand">
      {%- if settings.logo != blank -%}
        <a class="rsh-footer__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name }}">
          {{ settings.logo | image_url: width: 400 | image_tag: widths: '160, 240, 320, 400', sizes: '160px', loading: 'lazy', class: 'rsh-footer__logo-img', alt: shop.name }}
        </a>
      {%- else -%}
        <a class="rsh-footer__wordmark" href="{{ routes.root_url }}">{{ shop.name }}</a>
      {%- endif -%}
      {%- if section.settings.tagline != blank -%}
        <p class="rsh-footer__tagline">{{ section.settings.tagline }}</p>
      {%- endif -%}

      <ul class="rsh-footer__contact" role="list">
        {%- if email != blank -%}
          <li><a href="mailto:{{ email }}">{{ email }}</a></li>
        {%- endif -%}
        {%- if section.settings.phone != blank -%}
          <li><a href="tel:{{ section.settings.phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-' }}">{{ section.settings.phone }}</a></li>
        {%- endif -%}
        {%- if section.settings.location != blank -%}
          <li>{{ section.settings.location }}</li>
        {%- endif -%}
        {%- if section.settings.hours != blank -%}
          <li>{{ section.settings.hours }}</li>
        {%- endif -%}
      </ul>

      {%- liquid
        assign socials = ''
        if section.settings.social_instagram != blank
          assign socials = socials | append: 'instagram'
        endif
        if section.settings.social_facebook != blank
          assign socials = socials | append: 'facebook'
        endif
        if section.settings.social_linkedin != blank
          assign socials = socials | append: 'linkedin'
        endif
        if section.settings.social_youtube != blank
          assign socials = socials | append: 'youtube'
        endif
        if section.settings.social_tiktok != blank
          assign socials = socials | append: 'tiktok'
        endif
        if section.settings.social_x != blank
          assign socials = socials | append: 'x'
        endif
      -%}
      {%- if socials != blank -%}
        <ul class="rsh-footer__social" role="list" aria-label="Social">
          {%- if section.settings.social_instagram != blank -%}
            <li><a href="{{ section.settings.social_instagram }}" target="_blank" rel="noopener" aria-label="Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.3" cy="6.7" r="1" fill="currentColor" stroke="none"/></svg></a></li>
          {%- endif -%}
          {%- if section.settings.social_facebook != blank -%}
            <li><a href="{{ section.settings.social_facebook }}" target="_blank" rel="noopener" aria-label="Facebook"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13.5 21v-7h2.4l.4-3h-2.8V9.2c0-.9.3-1.5 1.5-1.5h1.4V5.1c-.3 0-1.1-.1-2.1-.1-2.1 0-3.6 1.3-3.6 3.7V11H8.2v3h2.5v7h2.8Z"/></svg></a></li>
          {%- endif -%}
          {%- if section.settings.social_linkedin != blank -%}
            <li><a href="{{ section.settings.social_linkedin }}" target="_blank" rel="noopener" aria-label="LinkedIn"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.4 9.5H3.6V20h2.8V9.5ZM5 4.2a1.6 1.6 0 1 0 0 3.3 1.6 1.6 0 0 0 0-3.3ZM20.4 20v-5.8c0-3-1.6-4.4-3.8-4.4-1.7 0-2.5 1-2.9 1.6V9.5H11V20h2.8v-5.4c0-1.4.3-2.8 2-2.8s1.8 1.6 1.8 2.9V20h2.8Z"/></svg></a></li>
          {%- endif -%}
          {%- if section.settings.social_youtube != blank -%}
            <li><a href="{{ section.settings.social_youtube }}" target="_blank" rel="noopener" aria-label="YouTube"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M3.5 8.2c.2-1.3 1-2.1 2.3-2.2C7.8 5.8 10 5.7 12 5.7s4.2.1 6.2.3c1.3.1 2.1.9 2.3 2.2.2 1.2.3 2.5.3 3.8s-.1 2.6-.3 3.8c-.2 1.3-1 2.1-2.3 2.2-2 .2-4.2.3-6.2.3s-4.2-.1-6.2-.3c-1.3-.1-2.1-.9-2.3-2.2A24 24 0 0 1 3.2 12c0-1.3.1-2.6.3-3.8Z"/><path d="m10.2 9.4 4.3 2.6-4.3 2.6V9.4Z" fill="currentColor" stroke="none"/></svg></a></li>
          {%- endif -%}
          {%- if section.settings.social_tiktok != blank -%}
            <li><a href="{{ section.settings.social_tiktok }}" target="_blank" rel="noopener" aria-label="TikTok"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16.6 3c.3 2.3 1.6 3.7 3.9 3.9v2.8c-1.4 0-2.7-.4-3.9-1.2v6.2A5.4 5.4 0 1 1 11.2 9.3c.4 0 .7 0 1 .1v2.9a2.6 2.6 0 1 0 1.6 2.4V3h2.8Z"/></svg></a></li>
          {%- endif -%}
          {%- if section.settings.social_x != blank -%}
            <li><a href="{{ section.settings.social_x }}" target="_blank" rel="noopener" aria-label="X"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.8 3h3l-6.7 7.7L22 21h-6.2l-4.8-6.3L5.4 21h-3l7.2-8.2L2 3h6.3l4.4 5.8L17.8 3Zm-1.1 16.2h1.7L7.4 4.7H5.6l11.1 14.5Z"/></svg></a></li>
          {%- endif -%}
        </ul>
      {%- endif -%}
    </div>

    <nav class="rsh-footer__columns" aria-label="Footer">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'menu' -%}
            {%- liquid
              assign list = linklists[block.settings.menu]
              assign links = list.links
              if block.settings.parent != blank
                assign links = blank
                for link in list.links
                  if link.title == block.settings.parent
                    assign links = link.links
                  endif
                endfor
              endif
            -%}
            {%- if links.size > 0 -%}
              <div class="rsh-footer__col" {{ block.shopify_attributes }}>
                <h3 class="rsh-footer__col-title">{{ block.settings.heading | default: list.title }}</h3>
                <ul class="rsh-footer__links" role="list">
                  {%- for link in links -%}
                    <li><a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a></li>
                  {%- endfor -%}
                  {%- if block.settings.extra_label != blank -%}
                    <li><a href="{{ block.settings.extra_url | default: routes.all_products_collection_url }}">{{ block.settings.extra_label }}</a></li>
                  {%- endif -%}
                </ul>
              </div>
            {%- endif -%}
          {%- when 'links' -%}
            <div class="rsh-footer__col" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}
                <h3 class="rsh-footer__col-title">{{ block.settings.heading }}</h3>
              {%- endif -%}
              <ul class="rsh-footer__links" role="list">
                {%- for i in (1..6) -%}
                  {%- assign lk = 'label_' | append: i -%}
                  {%- assign uk = 'url_' | append: i -%}
                  {%- if block.settings[lk] != blank -%}
                    <li><a href="{{ block.settings[uk] | default: '#' }}">{{ block.settings[lk] }}</a></li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </nav>
  </div>

  <div class="rsh-footer__foot">
    <div class="rsh-footer__foot-left">
      <p class="rsh-footer__copy">&copy; {{ year }} {{ shop.name }}.{% if section.settings.note != blank %} {{ section.settings.note }}{% endif %}</p>
      {%- if section.settings.show_policies -%}
        {%- capture policy_links -%}
          {%- for policy in shop.policies -%}
            {%- if policy.body != blank -%}
              <li><a href="{{ policy.url }}">{{ policy.title }}</a></li>
            {%- endif -%}
          {%- endfor -%}
        {%- endcapture -%}
        {%- if policy_links contains '<li>' -%}
          <ul class="rsh-footer__policies" role="list">{{ policy_links }}</ul>
        {%- endif -%}
      {%- endif -%}
    </div>
    <div class="rsh-footer__foot-right">
      {%- if section.settings.show_payment and shop.enabled_payment_types.size > 0 -%}
        <ul class="rsh-footer__payment" role="list" aria-label="Accepted payments">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag: class: 'rsh-footer__pay' }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
      <a class="rsh-footer__top" href="#MainContent">{{ section.settings.top_label | default: 'Back to top' }} <span aria-hidden="true">&uarr;</span></a>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "tag": "section",
  "class": "rsh-footer-section",
  "max_blocks": 4,
  "settings": [
    { "type": "header", "content": "Newsletter" },
    { "type": "checkbox", "id": "show_signup", "label": "Show the sign-up", "default": true },
    { "type": "text", "id": "signup_heading", "label": "Heading", "default": "Restock reminders and volume deals" },
    { "type": "text", "id": "signup_text", "label": "Text", "default": "Once a month at most. New lines, price drops, and the odd sample offer." },
    { "type": "text", "id": "signup_placeholder", "label": "Field placeholder", "default": "Work email" },
    { "type": "text", "id": "signup_button", "label": "Button", "default": "Sign up" },
    { "type": "text", "id": "signup_success", "label": "After signing up", "default": "You're on the list." },
    { "type": "header", "content": "Brand" },
    { "type": "text", "id": "tagline", "label": "One line", "default": "Wholesale restaurant supply by the case, with the per-piece price on every product." },
    { "type": "text", "id": "email", "label": "Email", "info": "Leave empty to use the store's contact email." },
    { "type": "text", "id": "phone", "label": "Phone" },
    { "type": "text", "id": "location", "label": "Location", "default": "Shipping nationwide from California" },
    { "type": "text", "id": "hours", "label": "Hours" },
    { "type": "header", "content": "Social", "info": "A network with no address is not shown." },
    { "type": "url", "id": "social_instagram", "label": "Instagram" },
    { "type": "url", "id": "social_facebook", "label": "Facebook" },
    { "type": "url", "id": "social_linkedin", "label": "LinkedIn" },
    { "type": "url", "id": "social_youtube", "label": "YouTube" },
    { "type": "url", "id": "social_tiktok", "label": "TikTok" },
    { "type": "url", "id": "social_x", "label": "X" },
    { "type": "header", "content": "Small print" },
    { "type": "text", "id": "note", "label": "After the copyright", "default": "All rights reserved." },
    { "type": "checkbox", "id": "show_policies", "label": "Link the store policies that are written", "default": true },
    { "type": "checkbox", "id": "show_payment", "label": "Show accepted payment marks", "default": true },
    { "type": "text", "id": "top_label", "label": "Back-to-top link", "default": "Back to top" },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding-block-start", "label": "Top", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding-block-end", "label": "Bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 32 }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Column from a menu",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "info": "Leave empty to use the menu's name." },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
        { "type": "text", "id": "parent", "label": "Only the links under", "info": "The exact title of one item in that menu, to show its sub-links instead of the whole menu. Leave empty for the whole menu." },
        { "type": "text", "id": "extra_label", "label": "One more link at the end" },
        { "type": "url", "id": "extra_url", "label": "It goes to" }
      ]
    },
    {
      "type": "links",
      "name": "Column of links",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "text", "id": "label_1", "label": "Link 1" }, { "type": "url", "id": "url_1", "label": "Goes to" },
        { "type": "text", "id": "label_2", "label": "Link 2" }, { "type": "url", "id": "url_2", "label": "Goes to" },
        { "type": "text", "id": "label_3", "label": "Link 3" }, { "type": "url", "id": "url_3", "label": "Goes to" },
        { "type": "text", "id": "label_4", "label": "Link 4" }, { "type": "url", "id": "url_4", "label": "Goes to" },
        { "type": "text", "id": "label_5", "label": "Link 5" }, { "type": "url", "id": "url_5", "label": "Goes to" },
        { "type": "text", "id": "label_6", "label": "Link 6" }, { "type": "url", "id": "url_6", "label": "Goes to" }
      ]
    }
  ],
  "enabled_on": { "groups": ["footer"] },
  "presets": [
    {
      "name": "Footer",
      "blocks": [
        { "type": "menu", "settings": { "heading": "Shop", "menu": "main-menu", "parent": "SHOP", "extra_label": "Shop all supplies" } },
        { "type": "menu", "settings": { "heading": "By business", "menu": "main-menu", "parent": "SHOP BY BUSINESS" } },
        { "type": "links", "settings": { "heading": "Company", "label_1": "Why us", "url_1": "/pages/why-us", "label_2": "Volume deals", "url_2": "/pages/deals", "label_3": "Contact", "url_3": "/pages/contact" } }
      ]
    }
  ]
}
{% endschema %}
