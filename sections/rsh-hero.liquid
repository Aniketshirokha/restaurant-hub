{%- doc -%}
  The home page hero.

  Built to work with no photograph, because none of the hero files are uploaded
  yet and a hero that waits for an image is a blank screen. The background is a
  gradient and a faint dock-floor grid; set an image and it sits underneath the
  same gradient instead.

  The interactive half is a working per-piece calculator rather than a picture.
  Drag the case count and the ladder applies in front of the buyer: the case
  price drops, the per-piece price drops with it, and the saving is named. That
  is the store's entire argument, demonstrated in the first screen instead of
  described.

  The arithmetic is not reimplemented here. It comes from the same
  `rsh-pricing` module the product page uses, reading the same ladder from
  `rsh-tier-list`, so the hero can never quote a price the product page
  contradicts.
{%- enddoc -%}

<script
  src="{{ 'rsh-hero.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% liquid
  assign example = section.settings.example_product
  assign namespace = settings.rsh_metafield_namespace | default: 'custom'

  if example != blank
    assign example_variant = example.selected_or_first_available_variant
    assign base_cents = example_variant.price
    assign pieces = example.metafields[namespace].pieces_per_case.value | plus: 0
    assign noun = example.metafields[namespace].piece_noun.value | default: settings.rsh_piece_noun | default: 'piece'
    assign example_title = example.title
  else
    assign price_parts = section.settings.example_price | default: '32.99' | split: '.'
    assign whole_dollars = price_parts[0] | plus: 0
    assign fraction = price_parts[1] | default: '0' | append: '00' | slice: 0, 2 | plus: 0
    assign base_cents = whole_dollars | times: 100 | plus: fraction
    assign pieces = section.settings.example_pieces | plus: 0
    assign noun = section.settings.example_noun | default: 'piece'
    assign example_title = section.settings.example_title
  endif

  capture tier_list
    render 'rsh-tier-list'
  endcapture
  assign tiers = tier_list | strip | split: ','

  capture tiers_json
    echo '['
    for tier in tiers
      assign parts = tier | split: ':'
      if forloop.index0 > 0
        echo ','
      endif
      echo '{"min":'
      echo parts[0]
      echo ',"discount":'
      echo parts[1]
      echo '}'
    endfor
    echo ']'
  endcapture

  assign quote_min = settings.rsh_quote_min | default: 50 | plus: 0
  assign max_cases = quote_min | minus: 1
  assign shop_link = section.settings.primary_link | default: routes.all_products_collection_url
  assign why_link = section.settings.secondary_link | default: '/pages/about'

  assign has_image = false
  if section.settings.image != blank or section.settings.image_key != blank
    assign has_image = true
  endif

  assign show_panel = false
  if section.settings.show_calculator and base_cents > 0 and pieces > 0
    assign show_panel = true
  endif

  assign ratio_d = section.settings.ratio_desktop | default: '21/9' | split: '/'
  assign ratio_m = section.settings.ratio_mobile | default: '4/5' | split: '/'
  assign shape_d = 42857
  assign shape_m = 125000
  assign d_w = ratio_d[0] | plus: 0
  assign d_h = ratio_d[1] | plus: 0
  if d_w > 0 and d_h > 0
    assign shape_d = d_h | times: 100000 | divided_by: d_w
  endif
  assign m_w = ratio_m[0] | plus: 0
  assign m_h = ratio_m[1] | plus: 0
  if m_w > 0 and m_h > 0
    assign shape_m = m_h | times: 100000 | divided_by: m_w
  endif
%}

<section
  class="rsh-hero{% if has_image %} rsh-hero--has-image{% endif %}{% unless section.settings.show_proof_mobile %} rsh-hero--proof-desktop-only{% endunless %}"
  data-layout="{% if show_panel %}split{% else %}text{% endif %}"
  style="
    --rsh-hero-shape: {{ shape_d }};
    --rsh-hero-shape-mobile: {{ shape_m }};
    --rsh-hero-scrim: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
  "
>
  {%- if section.settings.image != blank -%}
    <div class="rsh-hero__bg" aria-hidden="true">
      {{
        section.settings.image
        | image_url: width: 3000
        | image_tag:
          widths: '750, 1100, 1500, 2000, 3000',
          sizes: '100vw',
          loading: 'eager',
          fetchpriority: 'high',
          class: 'rsh-hero__img',
          alt: ''
      }}
    </div>
  {%- elsif section.settings.image_key != blank -%}
    <div class="rsh-hero__bg" aria-hidden="true">
      {%- render 'rsh-image',
        key: section.settings.image_key,
        sizes: '100vw',
        loading: 'eager',
        fetchpriority: 'high'
      -%}
    </div>
  {%- endif -%}

  {%- comment -%}
    The scrim is heaviest where the words are and clears toward the other side,
    so the photograph is still a photograph rather than a grey panel.
  {%- endcomment -%}
  <div class="rsh-hero__scrim" aria-hidden="true"></div>

  {%- unless has_image -%}
    <div class="rsh-hero__grain" aria-hidden="true"></div>
  {%- endunless -%}

  <div
    class="section section--{{ section.settings.section_width }} spacing-style rsh-hero__section"
    style="{% render 'spacing-style', settings: section.settings %}"
  >
    <div class="rsh-hero__inner">
    <div class="rsh-hero__copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="rsh-hero__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h1 class="rsh-hero__heading">
          {{ section.settings.heading }}
          {%- if section.settings.heading_accent != blank -%}
            <span class="rsh-hero__accent">{{ section.settings.heading_accent }}</span>
          {%- endif -%}
        </h1>
      {%- endif -%}

      {%- if section.settings.body != blank -%}
        <div class="rsh-hero__lede rte">{{ section.settings.body }}</div>
      {%- endif -%}

      <div class="rsh-hero__actions">
        <a href="{{ shop_link }}" class="rsh-hero__cta rsh-hero__cta--primary">
          {{ section.settings.primary_label }}
          <span class="rsh-hero__cta-arrow" aria-hidden="true">&rarr;</span>
        </a>
        <a href="{{ why_link }}" class="rsh-hero__cta rsh-hero__cta--ghost">
          {{ section.settings.secondary_label }}
        </a>
      </div>

      {%- if section.settings.proof_1 != blank or section.settings.proof_2 != blank or section.settings.proof_3 != blank -%}
        <ul class="rsh-hero__proof" role="list">
          {%- for n in (1..3) -%}
            {%- assign key = 'proof_' | append: n -%}
            {%- assign value = section.settings[key] -%}
            {%- if value != blank -%}
              <li class="rsh-hero__proof-item">
                <span class="rsh-hero__tick svg-wrapper" aria-hidden="true">
                  {{- 'icon-checkmark.svg' | inline_asset_content -}}
                </span>
                {{ value }}
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    {%- if show_panel -%}
      <rsh-hero-price
        class="rsh-hero__panel"
        data-base-price="{{ base_cents }}"
        data-pieces="{{ pieces }}"
        data-noun="{{ noun | escape }}"
        data-tiers="{{ tiers_json | strip | escape }}"
        data-decimals="{{ settings.rsh_per_piece_decimals | default: 3 }}"
        data-money-format="{{ shop.money_format | escape }}"
        data-currency="{{ cart.currency.iso_code | default: shop.currency }}"
        data-max="{{ max_cases }}"
      >
        <p class="rsh-hero__panel-label">{{ section.settings.panel_label }}</p>

        {%- if example_title != blank -%}
          <p class="rsh-hero__panel-product">{{ example_title }}</p>
        {%- endif -%}

        <p class="rsh-hero__figure">
          <span class="rsh-hero__figure-value" data-piece-price>&mdash;</span>
          <span class="rsh-hero__figure-unit">per {{ noun }}</span>
        </p>

        <p class="rsh-hero__figure-sub">
          <span data-case-price>&mdash;</span> per case
          <span class="rsh-hero__dot" aria-hidden="true">·</span>
          {{ pieces }} per case
        </p>

        <label class="rsh-hero__slider">
          <span class="rsh-hero__slider-top">
            <span>Cases you order</span>
            <output class="rsh-hero__slider-out" data-cases>1</output>
          </span>
          <input
            type="range"
            min="1"
            max="{{ max_cases }}"
            value="1"
            step="1"
            data-range
            aria-label="Cases you order"
          >
        </label>

        <p class="rsh-hero__saving" data-saving hidden></p>

        <noscript>
          <p class="rsh-hero__figure-sub">
            Drag to price it by the case — needs JavaScript. The full ladder is on
            every product page either way.
          </p>
        </noscript>
      </rsh-hero-price>
    {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "enabled_on": {
    "templates": ["index"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Wholesale restaurant supply"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The number that matters is"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading, highlighted words",
      "default": "per piece.",
      "info": "Set in the accent colour on the line below the heading."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>Containers, cups, gloves, liners and paper by the case — with the per-piece price on every product and the volume ladder in plain sight. Check it against your last invoice.</p>"
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary label",
      "default": "Shop all"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primary link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary label",
      "default": "Why us"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary link"
    },
    {
      "type": "header",
      "content": "Proof points"
    },
    {
      "type": "text",
      "id": "proof_1",
      "label": "First",
      "default": "In stock, ships nationwide"
    },
    {
      "type": "text",
      "id": "proof_2",
      "label": "Second",
      "default": "No membership, no minimum"
    },
    {
      "type": "text",
      "id": "proof_3",
      "label": "Third",
      "default": "Volume pricing counted across your whole cart"
    },
    {
      "type": "header",
      "content": "Price calculator"
    },
    {
      "type": "paragraph",
      "content": "Pick a product and the panel prices itself from that product, using the same ladder as the product page. The typed figures below are only used when no product is picked."
    },
    {
      "type": "checkbox",
      "id": "show_calculator",
      "label": "Show the calculator panel",
      "default": false,
      "info": "Off gives a text-only hero over the picture. On adds the panel beside it."
    },
    {
      "type": "text",
      "id": "panel_label",
      "label": "Panel label",
      "default": "Try it on a real case"
    },
    {
      "type": "product",
      "id": "example_product",
      "label": "Example product"
    },
    {
      "type": "text",
      "id": "example_title",
      "label": "Product name",
      "default": "24 oz microwavable bowl with lid"
    },
    {
      "type": "text",
      "id": "example_price",
      "label": "Case price",
      "default": "32.99"
    },
    {
      "type": "number",
      "id": "example_pieces",
      "label": "Pieces per case",
      "default": 150
    },
    {
      "type": "text",
      "id": "example_noun",
      "label": "Piece noun",
      "default": "bowl"
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Darken behind the text",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 80,
      "info": "Heaviest over the words and clearing toward the other side, so the picture still reads as a picture."
    },
    {
      "type": "text",
      "id": "image_key",
      "label": "Or a library filename",
      "info": "Used only when no image is picked above. A filename without the .webp, e.g. hero-warehouse-dock."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 56,
      "info": "The height of a transparent header is added to this automatically."
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "checkbox",
      "id": "show_proof_mobile",
      "label": "Keep the three lines on mobile",
      "info": "Off by default: the trust bar directly below repeats them, and they are what a portrait hero cannot fit.",
      "default": false
    },
    {
      "type": "select",
      "id": "ratio_desktop",
      "label": "Shape on desktop",
      "info": "The section takes this shape, so a background cropped to it is shown whole. Taller copy still wins over the shape rather than being cut off.",
      "options": [
        { "value": "21/9", "label": "21:9 \u2014 cinematic" },
        { "value": "3/1", "label": "3:1 \u2014 letterbox" },
        { "value": "16/9", "label": "16:9 \u2014 widescreen" },
        { "value": "2/1", "label": "2:1" }
      ],
      "default": "21/9"
    },
    {
      "type": "select",
      "id": "ratio_mobile",
      "label": "Shape on mobile",
      "options": [
        { "value": "4/5", "label": "4:5 \u2014 portrait" },
        { "value": "3/4", "label": "3:4" },
        { "value": "1/1", "label": "1:1 \u2014 square" },
        { "value": "9/16", "label": "9:16 \u2014 tall" }
      ],
      "default": "4/5"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Full" }
      ],
      "default": "page-width"
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
