{%- doc -%}
  Questions and answers as native disclosures. `<details>` opens and closes
  with no script, is keyboard-operable out of the box and is announced as
  expandable by screen readers, so there is nothing to reimplement. The first
  one ships open so the section does not read as a list of closed doors.

  Answers are rich text so one can carry a link to the page that answers it
  properly — the deals page for the minimum-order question, this site's Why us
  page for the price one.
{%- enddoc -%}

{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<div class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"></div>
<div
  class="section section--{{ section.settings.section_width }}{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %} spacing-style"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <div class="rsh-faq">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <div class="rsh-faq__head">
        {%- if section.settings.eyebrow != blank -%}
          <p class="rsh-eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="rsh-heading h2">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="rsh-faq__list">
      {%- for block in section.blocks -%}
        {%- if block.settings.question != blank -%}
          <details class="rsh-faq__item" {% if forloop.first and section.settings.open_first %}open{% endif %} {{ block.shopify_attributes }}>
            <summary class="rsh-faq__q">
              <span class="rsh-faq__q-text">{{ block.settings.question }}</span>
              <span class="rsh-faq__icon" aria-hidden="true"></span>
            </summary>
            <div class="rsh-faq__a rte">{{ block.settings.answer }}</div>
          </details>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Questions",
  "tag": "section",
  "max_blocks": 16,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "checkbox", "id": "open_first", "label": "Open the first question", "default": true },
    { "type": "header", "content": "Layout" },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [ { "value": "page-width", "label": "Page" }, { "value": "full-width", "label": "Full" } ],
      "default": "page-width"
    },
    { "type": "color", "id": "background_color", "label": "Background", "placeholder": "Default" },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding-block-start", "label": "Top", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding-block-end", "label": "Bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 64 }
  ],
  "blocks": [
    {
      "type": "qa",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question" },
        { "type": "richtext", "id": "answer", "label": "Answer" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Questions",
      "blocks": [
        { "type": "qa", "settings": { "question": "Do I need an account or membership to buy?", "answer": "<p>No. Prices are on the page and you can check out as a guest. An account just makes reordering faster.</p>" } },
        { "type": "qa", "settings": { "question": "Is there a minimum order?", "answer": "<p>No minimum to get started. Order a single case if that's what you need. Volume discounts kick in automatically as you add more.</p><p><a href=\"/pages/deals\">See volume pricing →</a></p>" } }
      ]
    }
  ]
}
{% endschema %}
