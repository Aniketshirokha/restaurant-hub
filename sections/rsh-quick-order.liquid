{%- doc -%}
  Quick order pad. Paste a reorder list, get a cart.

  Every serious B2B supplier has one of these and none of the direct competitors
  does it well, which makes it one of the cheapest advantages on the site.
{%- enddoc -%}

<script
  src="{{ 'rsh-quick-order.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>

<div
  class="
    section
    section--{{ section.settings.section_width }}
    {% if section.settings.background_color != blank %}color-custom-{{ section.id }}{% endif %}
    spacing-style gap-style
  "
  style="
    {% render 'spacing-style', settings: section.settings %}
    {% render 'gap-style', value: section.settings.gap %}
  "
>
  {%- if section.settings.heading != blank -%}
    <div class="rsh-block">
      <h2 class="rsh-heading h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.body != blank -%}
        <div class="rsh-lede rte">{{ section.settings.body }}</div>
      {%- endif -%}
    </div>
  {%- endif -%}

  <rsh-quick-order
    class="rsh-quick{% if section.settings.show_help %} rsh-quick--with-aside{% endif %}"
    data-money-format="{{ shop.money_format | escape }}"
    data-currency="{{ cart.currency.iso_code | default: shop.currency }}"
    data-redirect="{% if section.settings.go_to_cart %}true{% else %}false{% endif %}"
  >
    <div class="rsh-quick__panel">
      <label class="rsh-quick__label" for="rsh-quick-input-{{ section.id }}">
        {{ section.settings.field_label | default: 'Item numbers' }}
        <span class="rsh-quick__hint">
          {{- section.settings.field_hint | default: 'One per line. Add a quantity after the item number, for example TFRDB24, 4' -}}
        </span>
      </label>

      <textarea
        id="rsh-quick-input-{{ section.id }}"
        class="rsh-quick__input"
        ref="input"
        rows="6"
        spellcheck="false"
        autocapitalize="characters"
        placeholder="{{ section.settings.placeholder | escape }}"
      ></textarea>

      <div>
        <button type="button" class="button" ref="submit">
          {{ section.settings.button_label | default: 'Add to cart' }}
        </button>
      </div>

      <p class="rsh-quick__status" ref="status" role="status" aria-live="polite"></p>

      <div class="rsh-quick__results" ref="results"></div>
    </div>

    {%- if section.settings.show_help -%}
      <aside class="rsh-quick__aside">
        <h3>{{ section.settings.help_heading | default: 'How this works' }}</h3>
        <div class="rte">{{ section.settings.help_body }}</div>
      </aside>
    {%- endif -%}
  </rsh-quick-order>
</div>

{% schema %}
{
  "name": "Quick order pad",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Order from your list"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>Paste the item numbers you reorder and we will build the cart. Volume tiers apply to the whole cart once it lands.</p>"
    },
    {
      "type": "text",
      "id": "field_label",
      "label": "Field label",
      "default": "Item numbers"
    },
    {
      "type": "text",
      "id": "field_hint",
      "label": "Field hint",
      "default": "One per line. Add a quantity after the item number, for example TFRDB24, 4"
    },
    {
      "type": "textarea",
      "id": "placeholder",
      "label": "Placeholder",
      "default": "TFRDB24, 4\nCS903, 2\nPC150, 1"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Add to cart"
    },
    {
      "type": "checkbox",
      "id": "go_to_cart",
      "label": "Go to the cart after adding",
      "default": false
    },
    {
      "type": "header",
      "content": "Help panel"
    },
    {
      "type": "checkbox",
      "id": "show_help",
      "label": "Show the help panel",
      "default": true
    },
    {
      "type": "text",
      "id": "help_heading",
      "label": "Help heading",
      "default": "How this works"
    },
    {
      "type": "richtext",
      "id": "help_body",
      "label": "Help body",
      "default": "<p>Item numbers are printed on every product page under the title, and on your invoices.</p><p>Quantities are in cases. Leave the quantity off and we will add one case.</p><p>Anything we cannot match is listed back to you rather than guessed at.</p>"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Full" }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "placeholder": "Default"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Quick order pad"
    }
  ]
}
{% endschema %}
